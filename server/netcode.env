# Netcode switches for the game servers (server/run-host.sh reads them; docs/recon/server-performance.md,
# "Rubber-banding"). Committed, so a deploy applies them; empty = the game's own value. Off switch: empty it, deploy.
#   FANGS_NET_TICK=60     net driver tick caps 60/60 and no listen-server clamp (the Feb build: 30/30, clamped)
#   FANGS_POS_ERROR=3.0   MAXPOSITIONERRORSQUARED, the correction tolerance (Feb 0.5, Aug 8.5, UE default 3.0)
#   FANGS_NET_RATE=...    per-player rate cap in bytes/s (Feb 40000; players ask for ConfiguredInternetSpeed, the
#                         same value in tools/run/config/Engine.ini.template)
FANGS_NET_TICK=60
FANGS_POS_ERROR=
FANGS_NET_RATE=
