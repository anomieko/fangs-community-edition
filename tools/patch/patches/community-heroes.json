        { "op": "set-export-prop", "export": "wer_GEN_VARIABLE", "path": "BoxExtent.Y", "from": 240.0612, "to": 85.0 },
        { "op": "replace-call-arg", "function": "ExecuteUbergraph_BP_TA_ShieldGirl_Skill4", "call": "MOBAAreaOfEffectBoxContainerSpec", "arg": 1, "from": "self.wer.self.BoxExtent", "to": { "vec": [5.0, 240.0612, 161.8148] }, "count": 1 },
        { "op": "insert-code", "function": "ExecuteUbergraph_BP_TA_ShieldGirl_Skill4", "after": "SpawnSystemAttached", "code": [
          { "do": { "on": { "local": "CallFunc_SpawnSystemAttached_ReturnValue" }, "call": "/Script/Engine.SceneComponent:SetRelativeScale3D", "args": [ { "vec": [1.0, 0.85, 0.9] } ] } }
        ] },
        { "op": "insert-code", "function": "ExecuteUbergraph_BP_TA_ShieldGirl_Skill4", "before": "CloneDeferred", "code": [
          { "let-obj": "CallFunc_Array_Get_Item", "value": { "local": "CallFunc_CloneDeferred_ReturnValue" } }
        ] },
        { "op": "insert-code", "function": "ExecuteUbergraph_BP_TA_ShieldGirl_Skill4", "after": "CloneDeferred", "code": [
          { "if": { "math": "/Script/Engine.KismetMathLibrary:BooleanAND", "args": [
              { "math": "/Script/Engine.KismetStringLibrary:Contains", "args": [ { "math": "/Script/Engine.KismetSystemLibrary:GetObjectName", "args": [ { "local": "K2Node_Event_projectile" } ] }, { "str": "Gunslinger_Skill4_Projectile" }, { "bool": false }, { "bool": false } ] },
              { "math": "/Script/Engine.KismetStringLibrary:Contains", "args": [ { "math": "/Script/Engine.KismetSystemLibrary:GetObjectName", "args": [ { "local": "CallFunc_Array_Get_Item" } ] }, { "str": "Gunslinger_Skill4_Projectile" }, { "bool": false }, { "bool": false } ] }
