<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- third_party/ is not in git; override with -p:UAssetAPIDir=... when building from a worktree -->
    <UAssetAPIDir Condition="'$(UAssetAPIDir)' == ''">$(MSBuildThisFileDirectory)../../../third_party/UAssetAPI</UAssetAPIDir>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(UAssetAPIDir)/UAssetAPI/UAssetAPI.csproj" />
  </ItemGroup>
</Project>
