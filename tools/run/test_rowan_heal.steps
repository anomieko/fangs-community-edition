# Rowan's steps for tools/run/test_patch.sh (bob = Rowan; run through tools/run/test_rowan_heal.sh). Helpers:
# tools/run/test_rowan.lua (R.*) on the game server; results in its rowan.log.
host "lua return dofile(\"Z:$PWD/tools/run/test_rowan.lua\")"
# alice shoots bob down to 60-120 HP: as many of her basic attacks (60 damage) as his health on the server allows
# (a health value written by a test isn't seen by the heal code: the damage has to be real)
down() {
  local h0 h n try
  for try in 1 2 3; do
    host 'lua return FCE_PATCH.moveto("alice", 0, 0)'; sleep 2   # the middle of the map, away from both bases; her pointer follows
    host 'lua return FCE_PATCH.face("alice", "bob", 400)'
    host 'lua return FCE_PATCH.health("bob")'; sleep 2
    h0=$(grep -h 'lua ok: health: bob: health' $HOSTS/fangsctl.log 2>/dev/null | tail -1 | sed -E 's/.*health ([0-9.]+)\/.*/\1/')
    n=$(python3 -I -c 'import sys; print(max(0, int((float(sys.argv[1]) - 60) // 60)))' "${h0:-0}")
    echo "lua return FCE_PATCH.chain(\"BookMage_LMB\", $n, 1100)" >> $A
    sleep $(( n * 11 / 10 + 3 ))
    host 'lua return FCE_PATCH.health("bob")'; sleep 2
    h=$(grep -h 'lua ok: health: bob: health' $HOSTS/fangsctl.log 2>/dev/null | tail -1 | sed -E 's/.*health ([0-9.]+)\/.*/\1/')
    python3 -I -c 'import sys; sys.exit(0 if float(sys.argv[1]) < 130 else 1)' "${h:-999}" && break   # else her shots missed: again
  done
  host 'lua return FCE_PATCH.moveto("alice", 0, -1500)'   # out of the way (a Sourblossom hurts enemies)
}
plant() {   # bob plants a Sourblossom and stands in its ring, 200 from the plant (not on the plant itself)
  echo 'lua return FCE_PATCH.fire("WoodenSword_Skill4_C")' >> $B
  sleep 1.5; host 'lua return R.near("bob", 200)'
}
sleep 10; host 'lua return FCE_PATCH.health("bob")'   # after a respawn, if anything killed him
host 'lua return R.rate("bob")'
# 1. a community member's case: from about 90 HP on a Sourblossom (the passive alone), 15 s
down; plant
host 'lua return R.track("bob", 15, "Sourblossom from low health")'
sleep 16
# 2. an Earth Rend arc on a Sourblossom: he stands in both until the arc ends (3 s), then in the ring alone
sleep 1; plant; sleep 1
echo 'lua return FCE_PATCH.fire("WoodenSword_RMB")' >> $B
sleep 0.8; host 'lua return R.into("bob", "arc", 200)'
host 'lua return R.track("bob", 8, "Earth Rend arc on a Sourblossom")'
sleep 9
# 3. the ult's Overgrowth (The Bloomblade) on a Sourblossom, until it ends
host 'lua return FCE_PATCH.fill("bob")'
sleep 1; plant; sleep 1
echo 'lua return FCE_PATCH.fire("WoodenSword_Skill3")' >> $B
sleep 2.5; host 'lua return R.into("bob", "ult", 200)'   # once the ult's flight and its trail are done (it lasts 6 s)
host 'lua return R.track("bob", 10, "ult Overgrowth on a Sourblossom")'
sleep 11
# 4. Heal Sprite's rate (what the item does to the passive), from about 90 HP on a Sourblossom
host 'lua return R.aug("bob")'
down; plant
host 'lua return R.track("bob", 15, "Sourblossom from low health, Heal Sprite rate")'
sleep 16
host 'lua return R.rate("bob")'
