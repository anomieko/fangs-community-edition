# Astrada's cage steps for tools/run/test_patch.sh (run through tools/run/test_shield.sh MODE=cage): in the middle of
# the map, alice (Astrada) drops her Flame Cage on bob; both clients take screenshots at +0.6, +1.3 and +2.0 s: alice
# sees her own cage (the ally colours), bob an enemy's. Screenshots: work/logs/<run>-{alice,bob}-shots/.
# One cast per match: a second cast crashed alice's headless display (gamescope restarting Xwayland) on 17 Oct.
LOADS="lua return dofile(\"Z:$PWD/tools/run/test_shield.lua\")"
host "$LOADS"; echo "$LOADS" >> $A; echo "$LOADS" >> $B
sleep 15   # the opening moves can leave bob dead at a base: let him respawn first (S.stage heals but can't revive)
host "lua return S.stage(600)"; host 'lua return FCE_PATCH.fill("alice")'
sleep 1; host 'lua return FCE_PATCH.aim("alice", "bob", 1135)'   # bob where the cage lands (Flame Cage range 1135)
sleep 0.6; echo 'lua return FCE_PATCH.fire("Firemage_E")' >> $A
sleep 0.6; echo 'shot' >> $A; echo 'shot' >> $B
sleep 0.7; echo 'shot' >> $A; echo 'shot' >> $B
sleep 0.7; echo 'shot' >> $A; echo 'shot' >> $B
sleep 10
