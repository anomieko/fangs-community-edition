# Steps for tools/run/test_fiorne_lock.sh, once the round is on: alice's stack system and stacks (FangsHost's always-on
# safety net, if loaded, restarts a stack system that isn't running within about 4 s of the protection ending).
host 'lua return FCE_PASSIVES.state("alice")'
sleep 8; host 'lua return FCE_PASSIVES.state("alice")'
sleep 8; host 'lua return FCE_PASSIVES.state("alice")'
